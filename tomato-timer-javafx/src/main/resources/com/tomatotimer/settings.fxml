<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.util.*?>

<!--
  settings.fxml – equivalent to Page_Settings.xaml.
  Layout: back-button | scrollable settings row | version label
-->
<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tomatotimer.controller.SettingsController"
      prefHeight="44" maxWidth="Infinity"
      alignment="CENTER_LEFT"
      styleClass="page-root">

    <!-- Back button -->
    <Button styleClass="icon-btn"
            onAction="#onBack"
            focusTraversable="false">
        <tooltip><Tooltip text="Back to timer"/></tooltip>
        <graphic>
            <ImageView fitWidth="26" fitHeight="26" preserveRatio="true">
                <image><Image url="@icons/10-device-access-time.png"/></image>
            </ImageView>
        </graphic>
    </Button>

    <!-- Scrollable settings -->
    <ScrollPane HBox.hgrow="ALWAYS"
                fitToHeight="true"
                vbarPolicy="NEVER"
                hbarPolicy="AS_NEEDED"
                style="-fx-background-color: transparent; -fx-background: transparent;">

        <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 2 4 2 4;">

            <!-- Work time -->
            <Label text="Work:" styleClass="setting-label"/>
            <Spinner fx:id="spWorkTime" prefWidth="60" editable="true" focusTraversable="false">
                <valueFactory>
                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="120" initialValue="30"/>
                </valueFactory>
            </Spinner>

            <!-- Short rest time -->
            <Label text="Rest:" styleClass="setting-label"/>
            <Spinner fx:id="spRelaxTime" prefWidth="60" editable="true" focusTraversable="false">
                <valueFactory>
                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="60" initialValue="5"/>
                </valueFactory>
            </Spinner>

            <!-- Long rest time -->
            <Label text="Long:" styleClass="setting-label"/>
            <Spinner fx:id="spLongRelaxTime" prefWidth="60" editable="true" focusTraversable="false">
                <valueFactory>
                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="120" initialValue="15"/>
                </valueFactory>
            </Spinner>

            <!-- Google Calendar -->
            <Separator orientation="VERTICAL" prefHeight="30"/>
            <VBox alignment="CENTER_LEFT" spacing="2">
                <CheckBox fx:id="cbEnableGCal" text="GCal"
                          onAction="#onGCalEnableChanged"
                          focusTraversable="false"/>
                <CheckBox fx:id="cbCopyToClipboard" text="Copy URL"
                          focusTraversable="false"/>
            </VBox>

            <GridPane fx:id="gpGCalDetails" hgap="4" vgap="2">
                <columnConstraints>
                    <ColumnConstraints minWidth="60" halignment="RIGHT"/>
                    <ColumnConstraints prefWidth="160" hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Calendar ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                       styleClass="setting-label"/>
                <TextField fx:id="tfGCalSrc" GridPane.columnIndex="1" GridPane.rowIndex="0"
                           promptText="your-email@gmail.com" prefWidth="160"/>
                <Label text="Event Title:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                       styleClass="setting-label"/>
                <TextField fx:id="tfGCalText" GridPane.columnIndex="1" GridPane.rowIndex="1"
                           promptText="Pomodoro" prefWidth="160"/>
            </GridPane>

            <Button styleClass="icon-btn" onAction="#onTestGCal"
                    focusTraversable="false">
                <tooltip><Tooltip text="Test: open Google Calendar"/></tooltip>
                <graphic>
                    <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                        <image><Image url="@icons/4-collections-go-to-today.png"/></image>
                    </ImageView>
                </graphic>
            </Button>

            <!-- Sound settings -->
            <Separator orientation="VERTICAL" prefHeight="30"/>
            <Button styleClass="icon-btn" onAction="#onSoundSettings"
                    focusTraversable="false">
                <tooltip><Tooltip text="Sound settings"/></tooltip>
                <graphic>
                    <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                        <image><Image url="@icons/10-device-access-volume-on.png"/></image>
                    </ImageView>
                </graphic>
            </Button>

        </HBox>
    </ScrollPane>

    <!-- Version label -->
    <Label fx:id="labelVersion" text="v1.0.0"
           styleClass="label-version"
           HBox.hgrow="NEVER"/>

</HBox>



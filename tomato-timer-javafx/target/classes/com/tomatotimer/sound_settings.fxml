<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tomatotimer.controller.SoundSettingsController"
      prefHeight="44" maxWidth="Infinity"
      alignment="CENTER_LEFT"
      styleClass="page-root">

    <Button styleClass="icon-btn"
            onAction="#onBack"
            focusTraversable="false">
        <tooltip><Tooltip text="Back to settings"/></tooltip>
        <graphic>
            <ImageView fitWidth="26" fitHeight="26" preserveRatio="true">
                <image><Image url="@icons/10-device-access-time.png"/></image>
            </ImageView>
        </graphic>
    </Button>

    <ScrollPane HBox.hgrow="ALWAYS"
                fitToHeight="true"
                vbarPolicy="NEVER"
                hbarPolicy="AS_NEEDED"
                style="-fx-background-color: transparent; -fx-background: transparent;">

        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 2 4 2 4;">

            <!-- Resume -->
            <VBox alignment="CENTER" spacing="1">
                <Label text="Resume" styleClass="sound-label"/>
                <HBox spacing="2">
                    <Button fx:id="btnResumePlay"     styleClass="icon-btn-sm" onAction="#onResumePlay"     focusTraversable="false" text="▶"/>
                    <Button fx:id="btnResumeStop"     styleClass="icon-btn-sm" onAction="#onResumeStop"     focusTraversable="false" text="⏹" visible="false" managed="false"/>
                    <Button fx:id="btnResumeOpenFile" styleClass="icon-btn-sm" onAction="#onResumeOpenFile" focusTraversable="false" text="📂"/>
                    <Button fx:id="btnResumeMute"     styleClass="icon-btn-sm" onAction="#onResumeMute"     focusTraversable="false" text="🔇"/>
                </HBox>
            </VBox>

            <!-- Pause -->
            <VBox alignment="CENTER" spacing="1">
                <Label text="Pause" styleClass="sound-label"/>
                <HBox spacing="2">
                    <Button fx:id="btnPausePlay"     styleClass="icon-btn-sm" onAction="#onPausePlay"     focusTraversable="false" text="▶"/>
                    <Button fx:id="btnPauseStop"     styleClass="icon-btn-sm" onAction="#onPauseStop"     focusTraversable="false" text="⏹" visible="false" managed="false"/>
                    <Button fx:id="btnPauseOpenFile" styleClass="icon-btn-sm" onAction="#onPauseOpenFile" focusTraversable="false" text="📂"/>
                    <Button fx:id="btnPauseMute"     styleClass="icon-btn-sm" onAction="#onPauseMute"     focusTraversable="false" text="🔇"/>
                </HBox>
            </VBox>

            <!-- Work Done -->
            <VBox alignment="CENTER" spacing="1">
                <Label text="Work Done" styleClass="sound-label"/>
                <HBox spacing="2">
                    <Button fx:id="btnWorkPlay"     styleClass="icon-btn-sm" onAction="#onWorkPlay"     focusTraversable="false" text="▶"/>
                    <Button fx:id="btnWorkStop"     styleClass="icon-btn-sm" onAction="#onWorkStop"     focusTraversable="false" text="⏹" visible="false" managed="false"/>
                    <Button fx:id="btnWorkOpenFile" styleClass="icon-btn-sm" onAction="#onWorkOpenFile" focusTraversable="false" text="📂"/>
                    <Button fx:id="btnWorkMute"     styleClass="icon-btn-sm" onAction="#onWorkMute"     focusTraversable="false" text="🔇"/>
                </HBox>
            </VBox>

            <!-- Rest Timeout -->
            <VBox alignment="CENTER" spacing="1">
                <Label text="Rest End" styleClass="sound-label"/>
                <HBox spacing="2">
                    <Button fx:id="btnRestPlay"     styleClass="icon-btn-sm" onAction="#onRestPlay"     focusTraversable="false" text="▶"/>
                    <Button fx:id="btnRestStop"     styleClass="icon-btn-sm" onAction="#onRestStop"     focusTraversable="false" text="⏹" visible="false" managed="false"/>
                    <Button fx:id="btnRestOpenFile" styleClass="icon-btn-sm" onAction="#onRestOpenFile" focusTraversable="false" text="📂"/>
                    <Button fx:id="btnRestMute"     styleClass="icon-btn-sm" onAction="#onRestMute"     focusTraversable="false" text="🔇"/>
                </HBox>
            </VBox>

        </HBox>
    </ScrollPane>
</HBox>
